generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model PageView {
  id        Int      @id @default(autoincrement())
  ip        String?
  userAgent String?
  path      String   @default("/")
  createdAt DateTime @default(now())
}
